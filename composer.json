{
    "name": "hospital-manager/hospital-manager",
    "description": "A comprehensive hospital management system for Nigerian hospitals",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "10quality/wpmvc": "^1.0",
        "10quality/wpmvc-commands": "^1.0",
        "10quality/wpmvc-mvc": "^2.0",
        "composer/installers": "^2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "HospitalManager\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HospitalManager\\Tests\\": "tests/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "yoast/phpunit-polyfills": "^2.0",
        "mockery/mockery": "^1.6",
        "brain/monkey": "^2.0"
    }
}
