<?xml version="1.0"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    backupGlobals="false"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    >
    <testsuites>
        <testsuite name="HospitalManager">
            <directory prefix="test-" suffix=".php">./tests/</directory>
            <directory suffix="Test.php">./tests/</directory>
            <directory suffix="Test.php">./tests/Integration/</directory>
            <directory suffix="Test.php">./tests/Integration/Controllers/</directory>
            <directory suffix="Test.php">./tests/Integration/Controllers/Api/</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="WP_TESTS_DIR" value="/tmp/wordpress-tests-lib"/>
        <env name="WP_CORE_DIR" value="/tmp/wordpress"/>
    </php>
</phpunit>
